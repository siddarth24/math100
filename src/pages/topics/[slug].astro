---
import BaseLayout, { type TocItem } from '../../layouts/BaseLayout.astro';
import VideoEmbed from '../../components/VideoEmbed.astro';
import { getCollection } from 'astro:content';
import { getGroupById } from '../../data/groups';
import { renderMathText, withBase } from '../../lib/katex';
import { sectionHeading, sectionShortLabel } from '../../lib/section-label';

export async function getStaticPaths() {
  const allTopics = await getCollection('topics');

  return allTopics.map((topic) => ({
    params: { slug: topic.data.slug },
    props: { topic },
  }));
}

const { topic } = Astro.props;
const d = topic.data;
const group = getGroupById(d.group);

const stages = d.staged
  ? [1, 2, 3]
      .map((s) => ({
        stage: s,
        items: d.questions.filter((q) => q.stage === s),
      }))
      .filter((g) => g.items.length > 0)
  : [{ stage: null, items: d.questions }];

const headingTitle = sectionHeading(d.section, d.title);

const firstHalfCount = d.questions.filter((q) => q.half === 'first').length;
const harderHalfCount = d.questions.filter((q) => q.half === 'harder').length;
const allCheckIds = d.questions.map((q) => q.id).join(',');

const tocItems: TocItem[] = [
  { id: 'how-to-read-heading', label: 'How to read questions' },
  { id: 'prep-and-videos', label: 'Videos & preparation' },
  { id: 'practice-problems', label: `Practice (${d.questions.length})` },
  ...stages
    .filter((g) => g.stage !== null)
    .map((g) => ({
      id: `stage-${g.stage}`,
      label: `Stage ${g.stage} (${g.items.length})`,
      indent: true,
    })),
];
---

<BaseLayout title={headingTitle} currentSlug={d.slug} currentGroup={d.group} toc={tocItems}>
  <header class="topic-header">
    <h1>{headingTitle}</h1>
    <p class="topic-goal" set:html={renderMathText(d.goal)} />
  </header>

  <section class="how-to-read-block" aria-labelledby="how-to-read-heading">
    <h2 id="how-to-read-heading" class="how-to-read-title">{group.howToRead.title}</h2>
    <p set:html={renderMathText(group.howToRead.body)} />
    {
      group.howToRead.cueWords && group.howToRead.cueWords.length > 0 && (
        <ul class="how-to-read-cues">
          {group.howToRead.cueWords.map((cue) => (
            <li set:html={renderMathText(cue)} />
          ))}
        </ul>
      )
    }
  </section>

  <div class="prep-ledger" id="prep-and-videos" role="region" aria-label="Topic preparation and video links">
    <div class="prep-row">
      <div class="prep-label">Foundation</div>
      <div class="prep-content">
        <details class="before-this-details">
          <summary class="before-this-summary">Before this (precalculus &amp; setup)</summary>
          <div class="before-this-body">
            <p set:html={renderMathText(d.beforeThis.skill)} />
            {
              d.beforeThis.links.length > 0 && (
                <ul class="before-this-links">
                  {d.beforeThis.links.map((link) => (
                    <li>
                      <a href={withBase(link.href)}>{link.label}</a>
                    </li>
                  ))}
                </ul>
              )
            }
          </div>
        </details>
      </div>
    </div>

    <div class="prep-row">
      <div class="prep-label">See it</div>
      <div class="prep-content">
        <div class="video-grid">
          {
            d.seeIt.map((v) => (
              <VideoEmbed
                url={v.url}
                creator={v.creator}
                title={v.title}
                note={v.note}
                watchFor={v.watchFor}
              />
            ))
          }
        </div>
      </div>
    </div>

    {
      d.slowWalkthrough && d.slowWalkthrough.length > 0 && (
        <div class="prep-row">
          <div class="prep-label">Full lecture</div>
          <div class="prep-content">
            <div class="video-grid">
              {d.slowWalkthrough.map((v) => (
                <VideoEmbed
                  url={v.url}
                  creator={v.creator}
                  title={v.title}
                  watchFor={v.watchFor}
                />
              ))}
            </div>
          </div>
        </div>
      )
    }
  </div>

  <div class="practice-header" id="practice-problems">
    <div class="practice-header-title-group">
      <h2 class="practice-heading">Practice problems ({d.questions.length})</h2>
      <div class="practice-summary-pills">
        <span
          class="progress-pill"
          data-check-ids={allCheckIds}
          data-total={d.questions.length}
          data-verbose-progress="true"
        >
          0 / {d.questions.length} tried
        </span>
        {firstHalfCount > 0 && (
          <span class="tag-first-half">
            <span>first half</span>
            <span class="tag-count">{firstHalfCount}</span>
          </span>
        )}
        {harderHalfCount > 0 && (
          <span class="tag-harder-half">
            <span>harder half</span>
            <span class="tag-count">{harderHalfCount}</span>
          </span>
        )}
      </div>
    </div>

    <button
      type="button"
      class="clear-checks-btn"
      id="clear-topic-checks"
      data-section-slug={d.slug}
    >
      Clear checks on this page
    </button>
  </div>

  {
    d.practiceNote && (
      <p class="practice-note" set:html={renderMathText(d.practiceNote)} />
    )
  }

  {
    stages.map((groupBlock) => (
      <section class="stage-section">
        {groupBlock.stage !== null && (
          <h3 class="stage-heading" id={`stage-${groupBlock.stage}`}>
            <span>Stage {groupBlock.stage}</span>
            <span class="stage-count">{groupBlock.items.length} {groupBlock.items.length === 1 ? 'problem' : 'problems'}</span>
          </h3>
        )}
        <ol class="problem-list">
          {groupBlock.items.map((q) => (
            <li class="problem" id={q.id}>
              <div class="problem-meta">
                <span class="problem-number">
                  {sectionShortLabel(d.section)}, question {q.number}.
                </span>
                <div class="problem-tags">
                  {q.stage !== null && <span class="problem-stage">Stage {q.stage}</span>}
                  <span class={q.half === 'first' ? 'tag-first-half' : 'tag-harder-half'}>
                    {q.half === 'first' ? 'first half' : 'harder half'}
                  </span>
                  {q.oldExam && <span class="problem-exam-note">from an old UBC exam</span>}
                </div>
              </div>

              <details class="asking-disclosure">
                <summary class="asking-summary">
                  <span class="asking-summary-label">What this is asking</span>
                </summary>
                <div class="asking-text" set:html={renderMathText(q.asking)} />
              </details>

              <div class="problem-statement" set:html={renderMathText(q.statement)} />

              {q.figures &&
                q.figures.map((fig) => (
                  <figure class="problem-figure">
                    <img src={withBase(fig.src)} alt={fig.alt} loading="lazy" />
                  </figure>
                ))}

              <div class="problem-check-row">
                <label class="problem-check-label">
                  <input
                    type="checkbox"
                    class="problem-checkbox"
                    data-check-id={q.id}
                  />
                  <span>I tried this</span>
                </label>
              </div>
            </li>
          ))}
        </ol>
      </section>
    ))
  }

  <nav class="topic-pagination" aria-label="Section pagination">
    <div class="pagination-slot" hidden>
      <a href={withBase('/')} class="pagination-link" hidden>
        <span class="pagination-dir">← Previous section</span>
        <span class="pagination-title"></span>
      </a>
    </div>
    <div class="pagination-slot pagination-slot-next" hidden>
      <a href={withBase('/')} class="pagination-link pagination-link-next" hidden>
        <span class="pagination-dir">Next section →</span>
        <span class="pagination-title"></span>
      </a>
    </div>
  </nav>

  <script is:inline>
    (function () {
      const PREFIX = 'math100_check_';
      const checkboxes = document.querySelectorAll('.problem-checkbox[data-check-id]');

      checkboxes.forEach((cb) => {
        if (!(cb instanceof HTMLInputElement)) return;
        const id = cb.getAttribute('data-check-id');
        if (!id) return;
        try {
          cb.checked = localStorage.getItem(PREFIX + id) === '1';
        } catch (e) {}

        cb.addEventListener('change', () => {
          try {
            if (cb.checked) {
              localStorage.setItem(PREFIX + id, '1');
            } else {
              localStorage.removeItem(PREFIX + id);
            }
          } catch (e) {}
          window.dispatchEvent(new CustomEvent('math100:checks-updated'));
        });
      });

      const clearBtn = document.getElementById('clear-topic-checks');
      if (clearBtn) {
        clearBtn.addEventListener('click', () => {
          checkboxes.forEach((cb) => {
            if (!(cb instanceof HTMLInputElement)) return;
            const id = cb.getAttribute('data-check-id');
            cb.checked = false;
            if (id) {
              try {
                localStorage.removeItem(PREFIX + id);
              } catch (e) {}
            }
          });
          window.dispatchEvent(new CustomEvent('math100:checks-updated'));
        });
      }
    })();
  </script>
</BaseLayout>
