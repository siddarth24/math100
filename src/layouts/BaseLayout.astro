---
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import { getCollection } from 'astro:content';
import { NAV_GROUPS } from '../data/groups';
import { withBase } from '../lib/katex';
import { sectionShortLabel } from '../lib/section-label';

export interface TocItem {
  id: string;
  label: string;
  indent?: boolean;
}

interface Props {
  title: string;
  currentSlug?: string;
  currentGroup?: string;
  toc?: TocItem[];
}

const { title, currentSlug, currentGroup, toc = [] } = Astro.props;

const allTopics = await getCollection('topics');
const sortedTopics = [...allTopics].sort((a, b) => a.data.order - b.data.order);

const currentTopicObj = sortedTopics.find((t) => t.data.slug === currentSlug);
const drawerCurrentLabel = currentTopicObj
  ? `${sectionShortLabel(currentTopicObj.data.section)} ${currentTopicObj.data.shortTitle}`
  : currentSlug === 'precalculus'
    ? 'Precalculus reference'
    : 'Overview & syllabus';

const groupedNav = NAV_GROUPS.map((group) => ({
  ...group,
  topics: sortedTopics.filter((t) => t.data.group === group.id),
}));

const isHomePage = !currentSlug;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      try {
        var storedScheme = localStorage.getItem('color-scheme');
        var schemeMeta = document.querySelector('meta[name="color-scheme"]');
        if (storedScheme === 'light' || storedScheme === 'dark') {
          schemeMeta.setAttribute('content', storedScheme);
          document.documentElement.style.colorScheme = storedScheme;
        }
      } catch (e) {}
    </script>
    <title>{title} — UBC MATH 100/180 Study Guide</title>
    <link
      rel="icon"
      type="image/svg+xml"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%23002145'/%3E%3Ctext x='16' y='23' font-family='serif' font-size='20' font-style='italic' font-weight='bold' fill='%2364abff' text-anchor='middle'%3E%E2%88%AB%3C/text%3E%3C/svg%3E"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400;1,700&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="site-header-top">
        <div class="site-brand">
          <a href={withBase('/')} class="site-title">
            <svg
              class="brand-spark"
              viewBox="0 0 24 24"
              width="22"
              height="22"
              aria-hidden="true"
              focusable="false"
            >
              <path
                d="M15.75 3.25c-1.85 0-2.75 1.15-3.15 3.6L11.2 15.5c-.45 2.8-1.45 5.25-3.95 5.25-1.2 0-2-.55-2-1.35 0-.65.45-1.1 1.05-1.1.5 0 .85.3 1.05.75.15.3.35.4.65.4.85 0 1.35-1.15 1.65-3.1l1.4-8.65c.45-2.75 1.55-4.45 4.7-4.45 1.25 0 2.05.55 2.05 1.35 0 .65-.45 1.1-1.05 1.1-.5 0-.85-.3-1.05-.75-.15-.3-.35-.4-.65-.4Z"
                fill="currentColor"
              />
            </svg>
            <span class="site-title-serif">MATH 100 / 180 Study Guide</span>
          </a>
        </div>

        <div class="site-header-actions">
          <a
            href={withBase('/')}
            class="header-action-link"
            aria-current={!currentSlug ? 'page' : undefined}
          >
            Overview
          </a>
          <a
            href={withBase('/precalculus')}
            class="header-action-link"
            aria-current={currentSlug === 'precalculus' ? 'page' : undefined}
          >
            Precalculus sheet
          </a>
          <a
            href="https://personal.math.ubc.ca/~elyse/Math100Text/"
            class="header-cta-pill"
          >
            UBC Practice Book ›
          </a>
          <a
            href="https://tutorial.math.lamar.edu/Classes/CalcI/CalcI.aspx"
            class="header-cta-pill"
          >
            Paul's Math Notes ›
          </a>
          <button
            type="button"
            class="theme-toggle-btn"
            data-theme-toggle
            title="Toggle light or dark theme"
          >
            <span class="theme-opt theme-opt-light">
              <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true" focusable="false">
                <circle cx="10" cy="10" r="3.6" fill="none" stroke="currentColor" stroke-width="1.6" />
                <path
                  d="M10 2.2v2.1M10 15.7v2.1M2.2 10h2.1M15.7 10h2.1M4.48 4.48l1.48 1.48M14.04 14.04l1.48 1.48M15.52 4.48l-1.48 1.48M5.96 14.04l-1.48 1.48"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                />
              </svg>
              <span class="sr-only">Switch to light theme</span>
            </span>
            <span class="theme-opt theme-opt-dark">
              <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true" focusable="false">
                <path
                  d="M16.4 12.6A6.8 6.8 0 0 1 7.4 3.6a6.8 6.8 0 1 0 9 9Z"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linejoin="round"
                />
              </svg>
              <span class="sr-only">Switch to dark theme</span>
            </span>
          </button>
        </div>
      </div>

      <div class="site-header-sub" role="region" aria-label="Course and flavour selection">
        <div class="site-header-sub-inner">
          <div class="selector-group" role="group" aria-label="Course">
            <span class="selector-label">Course</span>
            <div class="tab-strip">
              <button type="button" class="selector-btn" data-course-btn="100" aria-pressed="false">
                MATH 100
              </button>
              <button type="button" class="selector-btn" data-course-btn="180" aria-pressed="false">
                MATH 180
              </button>
            </div>
          </div>

          <div class="selector-group" role="group" aria-label="Flavour">
            <span class="selector-label">Flavour</span>
            <div class="tab-strip">
              <button
                type="button"
                class="selector-btn"
                data-flavour-btn="A"
                aria-pressed="false"
                title="Physical sciences and engineering"
              >
                A · Phys / Eng
              </button>
              <button
                type="button"
                class="selector-btn"
                data-flavour-btn="B"
                aria-pressed="false"
                title="Life sciences"
              >
                B · Life Sci
              </button>
              <button
                type="button"
                class="selector-btn"
                data-flavour-btn="C"
                aria-pressed="false"
                title="Commerce and social sciences"
              >
                C · Commerce
              </button>
            </div>
          </div>

          <p class="selector-prompt" id="selector-prompt" hidden>
            Pick your course and flavour to filter topics (shared core Chapters 2–9.5 shown by default).
          </p>
        </div>
      </div>
    </header>

    <div class="site-shell">
      <nav class="topic-nav" aria-label="Course topics">
        <details class="topic-nav-drawer" id="topic-nav-drawer" open>
          <summary class="topic-nav-drawer-summary">
            <span class="drawer-summary-title">Course navigation</span>
            <span class="drawer-summary-current">{drawerCurrentLabel}</span>
          </summary>

          <div class="topic-nav-drawer-body">
            <div class="nav-group-static">
              <p class="nav-static-heading">Getting started</p>
              <ul class="nav-section-list">
                <li class="nav-section-item">
                  <a
                    href={withBase('/')}
                    class="nav-section-link nav-section-link-single"
                    aria-current={!currentSlug ? 'page' : undefined}
                  >
                    <span class="nav-sec-title">Overview</span>
                  </a>
                </li>
                <li class="nav-section-item">
                  <a
                    href={withBase('/precalculus')}
                    class="nav-section-link nav-section-link-single"
                    aria-current={currentSlug === 'precalculus' ? 'page' : undefined}
                  >
                    <span class="nav-sec-title">Precalculus reference</span>
                  </a>
                </li>
              </ul>
            </div>

            {
              groupedNav.map((group) => {
                const isOpen = currentGroup
                  ? group.id === currentGroup
                  : true;
                return (
                  <details
                    class="nav-group-details"
                    data-nav-group={group.id}
                    open={isOpen}
                  >
                    <summary class="nav-group-summary">{group.title}</summary>
                    <ul class="nav-section-list">
                      {group.topics.map((t) => {
                        const qIds = t.data.questions.map((q) => q.id).join(',');
                        return (
                          <li
                            class="nav-section-item"
                            data-nav-item={t.data.slug}
                            data-flavour={t.data.flavour}
                          >
                            <a
                              href={withBase(`/topics/${t.data.slug}`)}
                              class="nav-section-link"
                              aria-current={currentSlug === t.data.slug ? 'page' : undefined}
                            >
                              <span class="nav-sec-num">{sectionShortLabel(t.data.section)}</span>
                              <span class="nav-sec-title">{t.data.shortTitle}</span>
                              <span
                                class="nav-sec-count"
                                data-check-ids={qIds}
                                data-total={t.data.questions.length}
                              >
                                {t.data.questions.length}
                              </span>
                            </a>
                          </li>
                        );
                      })}
                    </ul>
                  </details>
                );
              })
            }
          </div>
        </details>
      </nav>

      <main class="main-column" id="main-content">
        <slot />
      </main>

      {
        toc.length > 0 && (
          <aside class="page-toc" aria-label="On this page">
            <p class="page-toc-heading">
              <svg
                viewBox="0 0 16 16"
                width="14"
                height="14"
                aria-hidden="true"
                focusable="false"
                class="toc-icon"
              >
                <path
                  d="M2 4h12M2 8h8M2 12h10"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                />
              </svg>
              <span>On this page</span>
            </p>
            <ul class="page-toc-list">
              {toc.map((item, idx) => (
                <li class={item.indent ? 'page-toc-item page-toc-item-sub' : 'page-toc-item'}>
                  <a
                    href={`#${item.id}`}
                    class={idx === 0 ? 'page-toc-link page-toc-link-active' : 'page-toc-link'}
                  >
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </aside>
        )
      }
    </div>

    <footer class="site-footer">
      <div class="site-footer-inner">
        <p>
          Practice problems and figures are adapted from the{' '}
          <a href="https://personal.math.ubc.ca/~elyse/Math100Text/">
            UBC Math 100 Practice Book (AY 2026/27)
          </a>
          , offered under the{' '}
          <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/">
            Creative Commons Attribution-NonCommercial-ShareAlike 4.0 International License (CC BY-NC-SA 4.0)
          </a>
          . This study site is shared under the same{' '}
          <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/">CC BY-NC-SA 4.0</a> license.
        </p>
        <p class="footer-credits">
          Credits: Kelly Paton and Elyse Yeager; Joel Feldman, Andrew Rechnitzer, and Elyse Yeager (CLP-1); Leah Edelstein-Keshet (<em>Differential Calculus for the Life Sciences</em>); and Bruno Belevan, Parham Hamidi, Nisha Malhotra, and Elyse Yeager (OIL).
        </p>
      </div>
    </footer>

    <script is:inline define:vars={{ isHomePage }}>
      (function () {
        const COURSE_KEY = 'math100_course';
        const FLAVOUR_KEY = 'math100_flavour';
        const CHECK_PREFIX = 'math100_check_';

        // Collapse the topic nav drawer by default on narrow screens when on a content page
        const drawer = document.getElementById('topic-nav-drawer');
        const mqDesktop = window.matchMedia('(min-width: 54rem)');
        function syncDrawerToViewport() {
          if (!drawer) return;
          if (mqDesktop.matches || isHomePage) {
            drawer.setAttribute('open', '');
          } else {
            drawer.removeAttribute('open');
          }
        }
        syncDrawerToViewport();
        if (mqDesktop.addEventListener) {
          mqDesktop.addEventListener('change', syncDrawerToViewport);
        }

        function matchesFlavour(itemFlavour, chosenFlavour) {
          if (!chosenFlavour) {
            return itemFlavour === 'all';
          }
          if (itemFlavour === 'all') return true;
          if (chosenFlavour === 'A') return itemFlavour === 'A' || itemFlavour === 'AB';
          if (chosenFlavour === 'B') return itemFlavour === 'B' || itemFlavour === 'AB';
          if (chosenFlavour === 'C') return itemFlavour === 'C';
          return true;
        }

        function updateProgressCounts() {
          document.querySelectorAll('[data-check-ids]').forEach((badge) => {
            const idsRaw = badge.getAttribute('data-check-ids') || '';
            const total = parseInt(badge.getAttribute('data-total') || '0', 10);
            if (!idsRaw || !total) return;
            const ids = idsRaw.split(',');
            let checked = 0;
            try {
              for (let i = 0; i < ids.length; i++) {
                if (localStorage.getItem(CHECK_PREFIX + ids[i]) === '1') {
                  checked++;
                }
              }
            } catch (e) {}

            if (badge.hasAttribute('data-verbose-progress')) {
              badge.textContent = `${checked} / ${total} tried`;
            } else {
              badge.textContent = checked > 0 ? `${checked}/${total}` : `${total}`;
            }
            badge.setAttribute('data-has-progress', checked > 0 ? 'true' : 'false');
            badge.setAttribute('data-complete', checked === total && total > 0 ? 'true' : 'false');
          });
        }

        function readStoredScheme() {
          try {
            const stored = localStorage.getItem('color-scheme');
            return stored === 'light' || stored === 'dark' ? stored : null;
          } catch (e) {
            return null;
          }
        }

        function applyColorScheme(stored) {
          const pinned = stored === 'light' || stored === 'dark' ? stored : null;
          const meta = document.querySelector('meta[name="color-scheme"]');
          if (meta) meta.setAttribute('content', pinned ?? 'light dark');
          document.documentElement.style.colorScheme = pinned ?? '';
        }

        function systemScheme() {
          return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }

        function syncBeforeThis(course) {
          document.querySelectorAll('.before-this-details').forEach((details) => {
            if (course === '180') details.setAttribute('open', '');
            else if (course === '100') details.removeAttribute('open');
          });
        }

        function syncPagination() {
          const visible = [...document.querySelectorAll('[data-nav-item]')].filter((item) => !item.hidden);
          const current = visible.findIndex(
            (item) => item.querySelector('a')?.getAttribute('aria-current') === 'page'
          );
          const prevLink = document.querySelector(
            '.topic-pagination .pagination-slot:not(.pagination-slot-next) .pagination-link'
          );
          const nextLink = document.querySelector('.topic-pagination .pagination-link-next');

          function point(anchor, item) {
            if (!anchor) return;
            const slot = anchor.parentElement;
            if (current < 0 || !item) {
              anchor.hidden = true;
              if (slot) slot.hidden = true;
              return;
            }
            const link = item.querySelector('a');
            const num = item.querySelector('.nav-sec-num')?.textContent?.trim() ?? '';
            const title = item.querySelector('.nav-sec-title')?.textContent?.trim() ?? '';
            const titleEl = anchor.querySelector('.pagination-title');
            anchor.hidden = false;
            if (slot) slot.hidden = false;
            if (link) anchor.href = link.href;
            if (titleEl) titleEl.textContent = `${num} ${title}`.trim();
          }

          point(prevLink, current > 0 ? visible[current - 1] : null);
          point(nextLink, current >= 0 && current < visible.length - 1 ? visible[current + 1] : null);
        }

        function syncPageToc() {
          const tocLinks = [...document.querySelectorAll('.page-toc-link')];
          if (!tocLinks.length) return;
          const headings = tocLinks
            .map((link) => {
              const id = (link.getAttribute('href') || '').replace(/^#/, '');
              const heading = id ? document.getElementById(id) : null;
              return heading ? { id, link, heading } : null;
            })
            .filter(Boolean);
          if (!headings.length) return;

          function setActive(id) {
            for (const entry of headings) {
              const on = entry.id === id;
              entry.link.classList.toggle('page-toc-link-active', on);
              if (on) entry.link.setAttribute('aria-current', 'location');
              else entry.link.removeAttribute('aria-current');
            }
          }

          const observer = new IntersectionObserver(
            (entries) => {
              const visible = entries
                .filter((entry) => entry.isIntersecting)
                .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
              if (visible.length) setActive(visible[0].target.id);
            },
            { rootMargin: '-104px 0px -55% 0px', threshold: [0, 1] }
          );
          for (const entry of headings) observer.observe(entry.heading);
        }

        function applyState() {
          let course = null;
          let flavour = null;
          try {
            course = localStorage.getItem(COURSE_KEY);
            flavour = localStorage.getItem(FLAVOUR_KEY);
          } catch (e) {}

          document.querySelectorAll('[data-course-btn]').forEach((btn) => {
            const val = btn.getAttribute('data-course-btn');
            btn.setAttribute('aria-pressed', val === course ? 'true' : 'false');
          });

          document.querySelectorAll('[data-flavour-btn]').forEach((btn) => {
            const val = btn.getAttribute('data-flavour-btn');
            btn.setAttribute('aria-pressed', val === flavour ? 'true' : 'false');
          });

          const promptEl = document.getElementById('selector-prompt');
          if (promptEl) {
            promptEl.hidden = Boolean(course && flavour);
          }

          // Filter navigation items and groups by flavour
          document.querySelectorAll('[data-nav-item]').forEach((item) => {
            const itemFlavour = item.getAttribute('data-flavour') || 'all';
            const link = item.querySelector('a');
            const isCurrent = link && link.getAttribute('aria-current') === 'page';
            const visible = isCurrent || matchesFlavour(itemFlavour, flavour);
            item.hidden = !visible;
          });

          document.querySelectorAll('[data-nav-group]').forEach((group) => {
            const visibleItems = group.querySelectorAll('[data-nav-item]:not([hidden])');
            group.hidden = visibleItems.length === 0;
          });

          // Filter any flavour-tagged elements in main content (such as home page topic lists)
          document.querySelectorAll('[data-content-flavour]').forEach((el) => {
            const elFlavour = el.getAttribute('data-content-flavour') || 'all';
            el.hidden = !matchesFlavour(elFlavour, flavour);
          });

          // Hide empty groups in main content if all child items are hidden
          document.querySelectorAll('[data-content-group]').forEach((groupEl) => {
            const visibleRows = groupEl.querySelectorAll('[data-content-flavour]:not([hidden])');
            groupEl.hidden = visibleRows.length === 0;
          });

          syncPagination();
        }

        applyState();
        try {
          syncBeforeThis(localStorage.getItem(COURSE_KEY));
        } catch (e) {}
        updateProgressCounts();
        try {
          syncPageToc();
        } catch (e) {}

        window.addEventListener('math100:checks-updated', updateProgressCounts);

        document.addEventListener('click', (e) => {
          const rawTarget = e.target;
          const target = rawTarget instanceof Element ? rawTarget : rawTarget?.parentElement;
          if (!(target instanceof Element)) return;

          const themeBtn = target.closest('[data-theme-toggle]');
          if (themeBtn) {
            const system = systemScheme();
            const currentRendered = readStoredScheme() ?? system;
            const targetScheme = currentRendered === 'dark' ? 'light' : 'dark';
            try {
              if (targetScheme !== system) localStorage.setItem('color-scheme', targetScheme);
              else localStorage.removeItem('color-scheme');
            } catch (err) {}
            applyColorScheme(targetScheme !== system ? targetScheme : null);
            return;
          }

          const courseBtn = target.closest('[data-course-btn]');
          if (courseBtn) {
            const val = courseBtn.getAttribute('data-course-btn');
            try {
              if (val) localStorage.setItem(COURSE_KEY, val);
            } catch (err) {}
            applyState();
            syncBeforeThis(val);
            return;
          }

          const flavourBtn = target.closest('[data-flavour-btn]');
          if (flavourBtn) {
            const val = flavourBtn.getAttribute('data-flavour-btn');
            try {
              if (val) localStorage.setItem(FLAVOUR_KEY, val);
            } catch (err) {}
            applyState();
            return;
          }
        });

        window.addEventListener('storage', (e) => {
          if (e.key === 'color-scheme') applyColorScheme(e.newValue);
        });

        window.addEventListener('pageshow', () => {
          applyColorScheme(readStoredScheme());
        });
      })();
    </script>
  </body>
</html>
