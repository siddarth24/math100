---
import { renderMathText } from '../lib/katex';

export const startDiagramSections: ReadonlySet<string> = new Set([
  '2.3',
  '3.3',
  '3.5',
  '8.2',
  '8.3',
  '10',
  '11',
]);

interface Props {
  section: string;
}

const { section } = Astro.props;
const shown = startDiagramSections.has(section);

const examples: Record<string, string> = {
  '2.3':
    '<p>Find every $x$ where</p>$$f(x)=\\frac{x^{2}-1}{x^{2}-x}$$<p>is not continuous. For each one, say whether the break is a hole, a jump, or infinite.</p>',
  '3.3':
    '<p>Let $f(0)=0$ and $f(x)=x^{2}\\sin(1/x)$ when $x\\neq 0$. Where is $f$ differentiable?</p>',
  '3.5':
    '<p>As $t\\to\\infty$, which of these die out to $0$, which keep bouncing, and which grow?</p>$$e^{-2t}\\sin t,\\qquad \\sin t,\\qquad e^{2t}\\sin t$$',
  '8.2':
    '<p>A rectangle has perimeter $20$. The length $\\ell$ can be any number with $0<\\ell<10$. Does the area have a largest value? A smallest value?</p>',
  '8.3':
    '<p>A rectangle has perimeter $20$. The length $\\ell$ can be any number with $0<\\ell<10$. Does the area have a largest value? A smallest value?</p>',
  '10':
    '<p>$f(x)=x^{2}-2$ changes sign from $x=1$ to $x=2$. Which of $1$ or $2$ should be your $x_{0}$ for Newton’s method? Choose that before you iterate.</p>',
  '11':
    '<p>You do not have a formula for $y(x)$. You know $y\'=x+y$ and $y(0)=1$. Find $y\'\'(0)$ for a Taylor polynomial. Do not solve the differential equation.</p>',
};

const walks: Record<string, string> = {
  '2.3': `<ol class="start-walk">
<li><strong>Factor first.</strong> $\\frac{x^{2}-1}{x^{2}-x}=\\frac{(x-1)(x+1)}{x(x-1)}$.</li>
<li><strong>Cancelled.</strong> The factor $x-1$ cancels, so $x=1$ is a hole. The simpler formula $(x+1)/x$ has height $2$ there. The original formula does not.</li>
<li><strong>Still zero.</strong> After that cancel, $x$ is still on the bottom, so $x=0$ is an infinite break.</li>
<li><strong>Different test.</strong> A jump is two heights that disagree. This is one formula, so there is no jump. Everywhere else the bottom is not zero.</li>
</ol>`,
  '3.3': `<ol class="start-walk">
<li><strong>Sort the $x$-values.</strong> $x\\neq 0$ is ordinary. $x=0$ is the special point, and it is also where the wiggles pile up.</li>
<li><strong>Ordinary points.</strong> For $x\\neq 0$ the formula is built from functions that already have a slope, so $f$ does too.</li>
<li><strong>Continuity first</strong> at $0$. The wiggles are trapped: $|f(x)|\\le x^{2}$, and $x^{2}\\to 0=f(0)$. So $f$ is continuous at $0$.</li>
<li><strong>Then the quotient.</strong> $\\frac{f(h)-f(0)}{h}=h\\sin(1/h)$, which is trapped near $0$. The slope settles, so $f$ is differentiable at $0$ as well. Everywhere.</li>
</ol>`,
  '3.5': `<ol class="start-walk">
<li><strong>$k$ negative.</strong> $e^{-2t}\\sin t$ has $k=-2$. The volume goes down to $0$. It dies out.</li>
<li><strong>$k$ is zero.</strong> $\\sin t$ has no exponential. The bounce stays.</li>
<li><strong>$k$ positive.</strong> $e^{2t}\\sin t$ has $k=2$. The bounce gets louder. It grows.</li>
</ol>`,
  '8.2': `<ol class="start-walk">
<li><strong>Find the critical points.</strong> The other side is $10-\\ell$, so the area is $A=\\ell(10-\\ell)$. Then $A'=10-2\\ell=0$ at $\\ell=5$, and $A(5)=25$.</li>
<li><strong>Does every end exist?</strong> No. Length $0$ and length $10$ are not allowed.</li>
<li><strong>The end runs away.</strong> As $\\ell$ slides toward $0$ or toward $10$, the area slides toward $0$. There is no smallest value. The critical point is still the largest: $25$.</li>
</ol>`,
  '10': `<ol class="start-walk">
<li><strong>Find the sign change.</strong> $f(1)=-1$ and $f(2)=2$.</li>
<li><strong>Compare the two $|f|$ values.</strong> $|f(1)|=1$ and $|f(2)|=2$. The smaller one is closer to the axis.</li>
<li><strong>Choose that integer.</strong> $x_{0}=1$. Do this before any iteration.</li>
<li><strong>Then Newton’s formula.</strong> $f'(x)=2x$, so $f'(1)=2$ and $x_{1}=1-\\frac{-1}{2}=\\frac{3}{2}$.</li>
</ol>`,
  '11': `<ol class="start-walk">
<li><strong>One fact, one tool.</strong> Do not solve for $y(x)$.</li>
<li><strong>At one time.</strong> $y(0)=1$ is already the value. The rate is $y'=x+y$, so $y'(0)=0+1=1$.</li>
<li><strong>No formula yet.</strong> Differentiate the rate: $y''=1+y'$. Then $y''(0)=1+y'(0)=1+1=2$.</li>
</ol>`,
};

walks['8.3'] = walks['8.2'];
---

{
  shown && (
    <summary class="how-to-start-summary">
      <h2 id="how-to-start" class="how-to-read-title how-to-start">How to start a hard question</h2>
    </summary>
    <p class="how-to-start-lead">
      A hard question glues two or three ideas into one. The picture is the order to try them. The example under it is that order, used once.
    </p>
  )
}

{
  section === '2.3' && (
    <figure class="start-diagram-scroll">
      <svg
        class="start-diagram"
        style="min-width: 640px"
        viewBox="0 0 640 448"
        role="img"
        aria-labelledby="break-title"
        aria-describedby="break-desc"
      >
        <title id="break-title">Factor first, then name the break</title>
        <desc id="break-desc">
          Factor the fraction first. A cancelled factor is a hole, because a simpler formula still has a height
          there. A zero that is still in the denominator is an infinite break, because the graph shoots up or down.
          If the denominator never hits zero, there is no break. One fraction can have a hole at one x and an
          infinite break at another. A jump is a different test: the left-hand height and the right-hand height
          disagree.
        </desc>
        <defs>
          <marker id="break-arrow" markerWidth="8" markerHeight="6" refX="7" refY="3" orient="auto">
            <polygon points="0 0, 8 3, 0 6" class="marker-head" />
          </marker>
        </defs>
        <line class="arrow" x1="320" y1="64" x2="320" y2="140" marker-end="url(#break-arrow)" />
        <path
          class="arrow"
          d="M260 64 V96 Q260 104 252 104 H128 Q120 104 120 112 V140"
          marker-end="url(#break-arrow)"
        />
        <path
          class="arrow"
          d="M380 64 V96 Q380 104 388 104 H512 Q520 104 520 112 V140"
          marker-end="url(#break-arrow)"
        />
        <rect class="node-start" x="200" y="20" width="240" height="44" rx="20" />
        <text class="name" x="320" y="47" text-anchor="middle">Factor first</text>
        <rect class="node-focal" x="28" y="140" width="184" height="108" rx="6" />
        <text class="eye eye-focal" x="120" y="164" text-anchor="middle">CANCELLED</text>
        <text class="name" x="120" y="186" text-anchor="middle">Hole</text>
        <text class="sub" x="120" y="208" text-anchor="middle">A simpler formula</text>
        <text class="sub" x="120" y="222" text-anchor="middle">still has a height</text>
        <rect class="node-focal" x="228" y="140" width="184" height="108" rx="6" />
        <text class="eye eye-focal" x="320" y="164" text-anchor="middle">STILL ZERO</text>
        <text class="name" x="320" y="186" text-anchor="middle">Infinite break</text>
        <text class="sub" x="320" y="208" text-anchor="middle">The graph shoots</text>
        <text class="sub" x="320" y="222" text-anchor="middle">up or down</text>
        <rect class="node" x="428" y="140" width="184" height="108" rx="6" />
        <text class="eye" x="520" y="164" text-anchor="middle">NEVER ZERO</text>
        <text class="name" x="520" y="186" text-anchor="middle">No break</text>
        <text class="sub" x="520" y="208" text-anchor="middle">The bottom never</text>
        <text class="sub" x="520" y="222" text-anchor="middle">hits zero</text>
        <rect class="node" x="28" y="276" width="584" height="72" rx="6" />
        <text class="eye" x="320" y="302" text-anchor="middle">DIFFERENT TEST</text>
        <text class="name" x="320" y="322" text-anchor="middle">Jump</text>
        <text class="sub" x="320" y="340" text-anchor="middle">Left-hand height and right-hand height disagree</text>
        <line class="legend-rule" x1="28" y1="372" x2="612" y2="372" />
        <text class="eye" x="28" y="396">LEGEND</text>
        <rect class="node-focal" x="100" y="386" width="16" height="12" rx="2" />
        <text class="sub" x="122" y="396">Hole or infinite break</text>
        <rect class="node" x="280" y="386" width="16" height="12" rx="2" />
        <text class="sub" x="302" y="396">No break</text>
        <rect class="node" x="380" y="386" width="16" height="12" rx="2" />
        <text class="sub" x="402" y="396">Jump, a different test</text>
      </svg>
      <figcaption class="start-diagram-caption">
        One fraction can have a hole at one x and an infinite break at another.
      </figcaption>
    </figure>
  )
}

{
  section === '3.3' && (
    <figure class="start-diagram-scroll">
      <svg
        class="start-diagram"
        style="min-width: 640px"
        viewBox="0 0 640 568"
        role="img"
        aria-labelledby="slope-title"
        aria-describedby="slope-desc"
      >
        <title id="slope-title">Sort the x-values, then test the slope</title>
        <desc id="slope-desc">
          Sort the x-values into three piles: one special point, ordinary points, and places where the specials pile
          up. Check a special point on its own. A flat ordinary piece has slope 0. Where spikes pile up, heights that
          shrink to 0 can still leave a slope. For each pile, check continuity first. No continuity means no slope.
          Then use the difference quotient and see if the slope settles as you zoom in.
        </desc>
        <defs>
          <marker id="slope-arrow" markerWidth="8" markerHeight="6" refX="7" refY="3" orient="auto">
            <polygon points="0 0, 8 3, 0 6" class="marker-head" />
          </marker>
        </defs>
        <path class="arrow" d="M250 68 V96 Q250 104 242 104 H128 Q120 104 120 112 V132" marker-end="url(#slope-arrow)" />
        <line class="arrow" x1="320" y1="68" x2="320" y2="132" marker-end="url(#slope-arrow)" />
        <path class="arrow" d="M390 68 V96 Q390 104 398 104 H512 Q520 104 520 112 V132" marker-end="url(#slope-arrow)" />
        <path class="arrow" d="M120 248 V276 Q120 284 128 284 H212 Q220 284 220 292 V312" marker-end="url(#slope-arrow)" />
        <line class="arrow" x1="320" y1="248" x2="320" y2="312" marker-end="url(#slope-arrow)" />
        <path class="arrow" d="M520 248 V276 Q520 284 512 284 H428 Q420 284 420 292 V312" marker-end="url(#slope-arrow)" />
        <line class="arrow" x1="320" y1="376" x2="320" y2="416" marker-end="url(#slope-arrow)" />
        <rect class="node" x="190" y="20" width="260" height="48" rx="6" />
        <text class="name" x="320" y="49" text-anchor="middle">Sort the x-values</text>
        <rect class="node" x="28" y="132" width="184" height="116" rx="6" />
        <text class="eye" x="120" y="158" text-anchor="middle">ONE POINT</text>
        <text class="name" x="120" y="182" text-anchor="middle">A special point</text>
        <text class="sub" x="120" y="206" text-anchor="middle">Check it on its own</text>
        <rect class="node" x="228" y="132" width="184" height="116" rx="6" />
        <text class="eye" x="320" y="158" text-anchor="middle">ORDINARY</text>
        <text class="name" x="320" y="182" text-anchor="middle">A flat piece</text>
        <text class="sub" x="320" y="206" text-anchor="middle">The slope is 0</text>
        <rect class="node-focal" x="428" y="132" width="184" height="116" rx="6" />
        <text class="eye eye-focal" x="520" y="158" text-anchor="middle">PILE UP</text>
        <text class="name" x="520" y="182" text-anchor="middle">Spikes stack here</text>
        <text class="sub" x="520" y="206" text-anchor="middle">Heights shrink to 0</text>
        <text class="sub" x="520" y="220" text-anchor="middle">The slope can settle</text>
        <rect class="node-focal" x="120" y="312" width="400" height="64" rx="6" />
        <text class="name" x="320" y="340" text-anchor="middle">Continuity first</text>
        <text class="sub" x="320" y="358" text-anchor="middle">No continuity means no slope</text>
        <rect class="node" x="170" y="416" width="300" height="64" rx="6" />
        <text class="name" x="320" y="444" text-anchor="middle">Then the quotient</text>
        <text class="sub" x="320" y="462" text-anchor="middle">Zoom in. Does the slope settle?</text>
        <line class="legend-rule" x1="28" y1="508" x2="612" y2="508" />
        <text class="eye" x="28" y="532">LEGEND</text>
        <rect class="node-focal" x="100" y="522" width="16" height="12" rx="2" />
        <text class="sub" x="122" y="532">Slow down here</text>
        <rect class="node" x="300" y="522" width="16" height="12" rx="2" />
        <text class="sub" x="322" y="532">One pile</text>
      </svg>
      <figcaption class="start-diagram-caption">
        One pile at a time. Continuity first, then the difference quotient.
      </figcaption>
    </figure>
  )
}

{
  section === '3.5' && (
    <figure class="start-diagram-scroll">
      <svg
        class="start-diagram"
        style="min-width: 640px"
        viewBox="0 0 640 420"
        role="img"
        aria-labelledby="knob-title"
        aria-describedby="knob-desc"
      >
        <title id="knob-title">The exponential is a volume knob</title>
        <desc id="knob-desc">
          Sine and cosine bounce between negative one and one forever. They never settle. e to the kt is the volume
          knob on that bounce. If k is negative, the volume goes down to 0. If k is zero, the bounce stays as it is.
          If k is positive, the bounce gets louder.
        </desc>
        <defs>
          <marker id="knob-arrow" markerWidth="8" markerHeight="6" refX="7" refY="3" orient="auto">
            <polygon points="0 0, 8 3, 0 6" class="marker-head" />
          </marker>
        </defs>
        <line class="arrow" x1="320" y1="60" x2="320" y2="92" marker-end="url(#knob-arrow)" />
        <path class="arrow" d="M235 144 V172 Q235 180 227 180 H128 Q120 180 120 188 V208" marker-end="url(#knob-arrow)" />
        <line class="arrow" x1="320" y1="144" x2="320" y2="208" marker-end="url(#knob-arrow)" />
        <path class="arrow" d="M405 144 V172 Q405 180 413 180 H512 Q520 180 520 188 V208" marker-end="url(#knob-arrow)" />
        <rect class="node-start" x="150" y="16" width="340" height="44" rx="20" />
        <text class="name" x="320" y="43" text-anchor="middle">Sine and cosine never settle</text>
        <rect class="node-focal" x="150" y="92" width="340" height="52" rx="6" />
        <text class="name" x="320" y="123" text-anchor="middle">e to the kt is the volume knob</text>
        <rect class="node-focal" x="28" y="208" width="184" height="108" rx="8" />
        <text class="eye eye-focal" x="120" y="234" text-anchor="middle">K NEGATIVE</text>
        <text class="name" x="120" y="258" text-anchor="middle">Dies out</text>
        <text class="sub" x="120" y="280" text-anchor="middle">Volume down to 0</text>
        <rect class="node" x="228" y="208" width="184" height="108" rx="8" />
        <text class="eye" x="320" y="234" text-anchor="middle">K IS ZERO</text>
        <text class="name" x="320" y="258" text-anchor="middle">Unchanged</text>
        <text class="sub" x="320" y="280" text-anchor="middle">The bounce stays</text>
        <rect class="node" x="428" y="208" width="184" height="108" rx="8" />
        <text class="eye" x="520" y="234" text-anchor="middle">K POSITIVE</text>
        <text class="name" x="520" y="258" text-anchor="middle">Gets louder</text>
        <text class="sub" x="520" y="280" text-anchor="middle">The bounce grows</text>
        <line class="legend-rule" x1="28" y1="344" x2="612" y2="344" />
        <text class="eye" x="28" y="368">LEGEND</text>
        <rect class="node-focal" x="100" y="358" width="16" height="12" rx="2" />
        <text class="sub" x="122" y="368">The knob, and the case that dies</text>
        <rect class="node" x="340" y="358" width="16" height="12" rx="2" />
        <text class="sub" x="362" y="368">The other two signs of k</text>
      </svg>
      <figcaption class="start-diagram-caption">
        Sine and cosine keep bouncing. The exponential only turns the volume down when its rate is negative.
      </figcaption>
    </figure>
  )
}

{
  (section === '8.2' || section === '8.3') && (
    <figure class="start-diagram-scroll">
      <svg
        class="start-diagram"
        style="min-width: 640px"
        viewBox="0 0 640 464"
        role="img"
        aria-labelledby="end-title"
        aria-describedby="end-desc"
      >
        <title id="end-title">Check whether the domain has ends</title>
        <desc id="end-desc">
          Find the critical points, then ask whether every end of the domain exists. If both ends exist, plug those
          in along with the critical points. If an end runs away, a shape can get extremely flat or tall and still be
          allowed. When the quantity slides toward 0 there, there is no smallest value. The critical point can still
          be the largest.
        </desc>
        <defs>
          <marker id="end-arrow" markerWidth="8" markerHeight="6" refX="7" refY="3" orient="auto">
            <polygon points="0 0, 8 3, 0 6" class="marker-head" />
          </marker>
          <marker id="end-arrow-focal" markerWidth="8" markerHeight="6" refX="7" refY="3" orient="auto">
            <polygon points="0 0, 8 3, 0 6" class="marker-head-focal" />
          </marker>
        </defs>
        <line class="arrow" x1="320" y1="64" x2="320" y2="100" marker-end="url(#end-arrow)" />
        <path class="arrow" d="M210 148 H162 Q154 148 154 156 V260" marker-end="url(#end-arrow)" />
        <path class="arrow-focal" d="M430 148 H478 Q486 148 486 156 V260" marker-end="url(#end-arrow-focal)" />
        <rect class="mask" x="162" y="188" width="36" height="16" />
        <text class="eye" x="180" y="200" text-anchor="middle">YES</text>
        <rect class="mask" x="442" y="188" width="32" height="16" />
        <text class="eye eye-focal" x="458" y="200" text-anchor="middle">NO</text>
        <rect class="node" x="170" y="16" width="300" height="48" rx="6" />
        <text class="name" x="320" y="45" text-anchor="middle">Find the critical points</text>
        <polygon class="node" points="320,100 430,148 320,196 210,148" />
        <text class="name" x="320" y="146" text-anchor="middle">Does every</text>
        <text class="name" x="320" y="162" text-anchor="middle">end exist?</text>
        <rect class="node" x="24" y="260" width="260" height="100" rx="6" />
        <text class="name" x="154" y="296" text-anchor="middle">Both ends exist</text>
        <text class="sub" x="154" y="318" text-anchor="middle">Plug in the ends and</text>
        <text class="sub" x="154" y="332" text-anchor="middle">the critical points</text>
        <rect class="node-focal" x="356" y="260" width="260" height="116" rx="6" />
        <text class="name" x="486" y="288" text-anchor="middle">The end runs away</text>
        <text class="sub" x="486" y="310" text-anchor="middle">Flat or tall can still count</text>
        <text class="sub" x="486" y="324" text-anchor="middle">Sliding to 0: no smallest</text>
        <text class="sub" x="486" y="338" text-anchor="middle">A peak can still be largest</text>
        <line class="legend-rule" x1="24" y1="404" x2="616" y2="404" />
        <text class="eye" x="24" y="428">LEGEND</text>
        <polygon class="node" points="118,422 128,428 118,434 108,428" />
        <text class="sub" x="136" y="432">Question</text>
        <rect class="node-focal" x="220" y="422" width="16" height="12" rx="2" />
        <text class="sub" x="242" y="432">Missing end</text>
        <rect class="node" x="360" y="422" width="16" height="12" rx="2" />
        <text class="sub" x="382" y="432">Closed interval</text>
      </svg>
      <figcaption class="start-diagram-caption">
        A missing end can erase the smallest value and still leave a largest.
      </figcaption>
    </figure>
  )
}

{
  section === '10' && (
    <figure class="start-diagram-scroll">
      <svg
        class="start-diagram"
        style="min-width: 440px"
        viewBox="0 0 440 500"
        role="img"
        aria-labelledby="newton-title"
        aria-describedby="newton-desc"
      >
        <title id="newton-title">Choose the start before Newton’s formula</title>
        <desc id="newton-desc">
          Find the two integers where the function changes sign. Compare the absolute values there. The integer
          where the absolute value is smaller is closer to the axis, so choose that as x0. Only then use Newton’s
          formula. Do not iterate until x0 is chosen.
        </desc>
        <defs>
          <marker id="newton-arrow" markerWidth="8" markerHeight="6" refX="7" refY="3" orient="auto">
            <polygon points="0 0, 8 3, 0 6" class="marker-head" />
          </marker>
          <marker id="newton-arrow-focal" markerWidth="8" markerHeight="6" refX="7" refY="3" orient="auto">
            <polygon points="0 0, 8 3, 0 6" class="marker-head-focal" />
          </marker>
        </defs>
        <line class="arrow" x1="220" y1="88" x2="220" y2="124" marker-end="url(#newton-arrow)" />
        <line class="arrow-focal" x1="220" y1="196" x2="220" y2="232" marker-end="url(#newton-arrow-focal)" />
        <line class="arrow" x1="220" y1="304" x2="220" y2="340" marker-end="url(#newton-arrow)" />
        <rect class="node" x="70" y="16" width="300" height="72" rx="6" />
        <text class="eye" x="220" y="38" text-anchor="middle">STEP 1</text>
        <text class="name" x="220" y="58" text-anchor="middle">Find the sign change</text>
        <text class="sub" x="220" y="76" text-anchor="middle">The root is between two integers</text>
        <rect class="node" x="70" y="124" width="300" height="72" rx="6" />
        <text class="eye" x="220" y="146" text-anchor="middle">STEP 2</text>
        <text class="name" x="220" y="166" text-anchor="middle">Compare the two |f| values</text>
        <text class="sub" x="220" y="184" text-anchor="middle">Smaller |f| is closer to the axis</text>
        <rect class="node-focal" x="70" y="232" width="300" height="72" rx="6" />
        <text class="eye eye-focal" x="220" y="254" text-anchor="middle">STEP 3</text>
        <text class="name" x="220" y="274" text-anchor="middle">Choose that integer</text>
        <text class="sub" x="220" y="292" text-anchor="middle">This is your start. Pick it before you iterate</text>
        <rect class="node" x="70" y="340" width="300" height="72" rx="6" />
        <text class="eye" x="220" y="362" text-anchor="middle">STEP 4</text>
        <text class="name" x="220" y="382" text-anchor="middle">Then Newton’s formula</text>
        <text class="sub" x="220" y="400" text-anchor="middle">One new x per step</text>
        <line class="legend-rule" x1="70" y1="436" x2="370" y2="436" />
        <text class="eye" x="70" y="460">LEGEND</text>
        <rect class="node-focal" x="140" y="450" width="16" height="12" rx="2" />
        <text class="sub" x="162" y="460">Choose the start first</text>
      </svg>
      <figcaption class="start-diagram-caption">
        The closer integer is the one with the smaller absolute value. Choose it, then iterate.
      </figcaption>
    </figure>
  )
}

{
  section === '11' && (
    <figure class="start-diagram-scroll">
      <svg
        class="start-diagram"
        style="min-width: 640px"
        viewBox="0 0 640 400"
        role="img"
        aria-labelledby="mix-title"
        aria-describedby="mix-desc"
      >
        <title id="mix-title">One fact, one tool</title>
        <desc id="mix-desc">
          Write each given fact on its own line. Do not hunt for a closed form first. A value at one time: plug in
          for position, and differentiate before you plug in for velocity. A long-time claim is the sign of the
          exponential’s rate: the bounce dies only when that rate is negative. When you have no formula for the
          solution, differentiate the rate equation to get the next derivative for a Taylor polynomial. To prove a
          sign, including that a product with an exponential is increasing, substitute the given rate and read the
          sign. You do not need the whole curve.
        </desc>
        <defs>
          <marker id="mix-arrow" markerWidth="8" markerHeight="6" refX="7" refY="3" orient="auto">
            <polygon points="0 0, 8 3, 0 6" class="marker-head" />
          </marker>
        </defs>
        <path class="arrow" d="M240 72 V100 Q240 108 232 108 H128 Q120 108 120 116 V140" marker-end="url(#mix-arrow)" />
        <line class="arrow" x1="320" y1="72" x2="320" y2="140" marker-end="url(#mix-arrow)" />
        <path class="arrow" d="M400 72 V100 Q400 108 408 108 H512 Q520 108 520 116 V140" marker-end="url(#mix-arrow)" />
        <rect class="node-focal" x="160" y="16" width="320" height="56" rx="20" />
        <text class="name" x="320" y="40" text-anchor="middle">One fact, one tool</text>
        <text class="sub" x="320" y="58" text-anchor="middle">Do not solve the whole thing</text>
        <rect class="node" x="28" y="140" width="184" height="148" rx="6" />
        <text class="eye" x="120" y="164" text-anchor="middle">AT ONE TIME</text>
        <text class="name" x="120" y="188" text-anchor="middle">Plug in a value</text>
        <text class="sub" x="120" y="212" text-anchor="middle">Position: just plug in</text>
        <text class="sub" x="120" y="226" text-anchor="middle">Velocity: derivative</text>
        <text class="sub" x="120" y="240" text-anchor="middle">first, then plug in</text>
        <rect class="node" x="228" y="140" width="184" height="148" rx="6" />
        <text class="eye" x="320" y="164" text-anchor="middle">AFTER A LONG TIME</text>
        <text class="name" x="320" y="188" text-anchor="middle">Read the sign of k</text>
        <text class="sub" x="320" y="212" text-anchor="middle">The bounce dies out</text>
        <text class="sub" x="320" y="226" text-anchor="middle">only if k is negative</text>
        <rect class="node-focal" x="428" y="140" width="184" height="148" rx="6" />
        <text class="eye eye-focal" x="520" y="164" text-anchor="middle">NO FORMULA YET</text>
        <text class="name" x="520" y="188" text-anchor="middle">Differentiate the rate</text>
        <text class="sub" x="520" y="212" text-anchor="middle">That builds the next</text>
        <text class="sub" x="520" y="226" text-anchor="middle">derivative. For a sign,</text>
        <text class="sub" x="520" y="240" text-anchor="middle">substitute, then read it</text>
        <line class="legend-rule" x1="28" y1="316" x2="612" y2="316" />
        <text class="eye" x="28" y="340">LEGEND</text>
        <rect class="node-focal" x="100" y="330" width="16" height="12" rx="2" />
        <text class="sub" x="122" y="340">No formula yet: don’t solve it</text>
        <rect class="node" x="340" y="330" width="16" height="12" rx="2" />
        <text class="sub" x="362" y="340">One fact you were given</text>
      </svg>
      <figcaption class="start-diagram-caption">
        A long question is these facts on separate lines. Each line uses one tool.
      </figcaption>
    </figure>
  )
}

{
  shown && examples[section] && (
    <div class="start-example">
      <p class="start-example-kicker">Example</p>
      <div class="problem-statement" set:html={renderMathText(examples[section])} />
      <p class="start-example-kicker start-walk-kicker">In the picture’s order</p>
      <div set:html={renderMathText(walks[section])} />
    </div>
  )
}
